# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# Lấy cả ba giá trị ở Supabase Dashboard → Project Settings → API.

# URL của project Supabase (ví dụ https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Khoá anon (public) — dùng cho đăng nhập phía trình duyệt
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khoá service_role — CHỈ dùng phía server và trong script cầu nối.
# TUYỆT ĐỐI không đưa khoá này ra trình duyệt hay commit vào git.
SUPABASE_SERVICE_ROLE_KEY=
