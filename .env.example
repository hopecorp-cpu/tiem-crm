# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# Lấy cả ba giá trị ở Supabase Dashboard → Project Settings → API.

# URL của project Supabase (ví dụ https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Khoá anon (public) — dùng cho đăng nhập phía trình duyệt
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Khoá service_role — CHỈ dùng phía server và trong script cầu nối.
# TUYỆT ĐỐI không đưa khoá này ra trình duyệt hay commit vào git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- FACEBOOK
# App Secret của ứng dụng Meta. Dùng để KIỂM CHỮ KÝ webhook — thiếu biến này thì
# mọi tin webhook đều bị từ chối (cố ý: thà không nhận còn hơn nhận tin giả).
FB_APP_SECRET=

# --------------------------------------------------------------------- BOT
# Khoá cho máy gọi /api/bot/zalo (bot quét hộp thư Zalo theo chu kỳ). Tự nghĩ một
# chuỗi dài ngẫu nhiên. Để trống thì đường đó chỉ nhân viên đã đăng nhập mới gọi được.
BOT_QUET_KEY=

# Địa chỉ web của bạn, ví dụ https://tiem-cua-ban.vercel.app
# Bot dán link đặt lịch cho khách bằng biến này; để trống thì link ra dạng rút gọn.
NEXT_PUBLIC_APP_URL=
